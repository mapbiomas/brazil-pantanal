/**
 * @name 02_spatial_and_flood_filters.js
 * @description Applies spatial filter (focal mode) to remove noise and corrects false positives of pasture/agriculture in flooded areas using Flood Frequency and NDDI.
 * @author @Mariana Dias / mariana@arcplan.com.br
 * @biome Pantanal
 */


// ==============================================================================
// 1. PARAMETERS AND CONSTANTS
// ==============================================================================
var IS_DEBUG = false;

var VERSION_IN = '1';  // Input from Gap Fill
var VERSION_OUT = '1'; // Output for this filter

var DIR_BASE = 'projects/mapbiomas-workspace/AMOSTRAS/S2_EMBEDDING/PANTANAL/';
var ASSET_IN = DIR_BASE + 'PANT_col3_S2_annual_gapfill_v' + VERSION_IN;
var PREFIX_OUT = 'PANT_col3_S2_annual_spatial_flood_v';

var YEARS = [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025];

// Spatial Filter Parameters
var MIN_CONNECTED_PIXELS = 25;

// Flood/Water NDDI Thresholds
var THRESHOLD_FLOOD = 850; // Higher values include more flooded areas
var THRESHOLD_WATER = 750; // Higher values include less water areas

// Remap rules for flooded areas (Original + 100) -> Target Class
// 3(Forest), 4(Savanna), 19(Agri), 21(Pasture) inside flooded areas become 12(Grassland)
var REMAP_FROM = [3, 4, 11, 12, 19, 21, 25, 29, 33, 103, 104, 111, 112, 119, 121, 125, 129, 133];
var REMAP_TO   = [3, 4, 11, 12, 19, 21, 25, 29, 33,  12,  12,  11,  12,  12,  12,  25,  29,  33];

// ==============================================================================
// 2. IMPORTS AND GEOMETRIES
// ==============================================================================
var palettes = require('users/mapbiomas/modules:Palettes.js');
var visPar = { min: 0, max: 62, palette: palettes.get('classification8') };

// Geometries and External Assets
var regionsCollection = ee.FeatureCollection('projects/ee-arcplan-df/assets/regioes_pantanal');
var geometry = regionsCollection.geometry().bounds();

var assetMos1 = ee.ImageCollection('projects/mapbiomas-mosaics/assets/SENTINEL/BRAZIL/mosaics-3');
var assetMos2 = ee.ImageCollection('projects/nexgenmap/MapBiomas2/SENTINEL/mosaics-3');
var colMosaics = assetMos1.merge(assetMos2);

var freqAlagado = ee.Image('projects/mapbiomas-workspace/AMOSTRAS/col10/PANTANAL/SAMPLES/mensal/frequenciaAcumulada_bruta_33_11_v1');
var addIndex = require('users/gee_arcplan/MapBiomas_Col10_Pantanal:processa_Bandas_Indices_DF_lite');

// Input Classification
var inputClassification = ee.Image(ASSET_IN);

// ==============================================================================
// 3. MAIN PROCESSING
// ==============================================================================

// ------------------------------------------------------------------------------
// PHASE 1: SPATIAL FILTER (FOCAL MODE)
// ------------------------------------------------------------------------------
var bandNamesList = ee.List(YEARS.map(function (year) { return 'classification_' + year; }));

// Calculate connected pixels for each band
var connectedPixelsImg = inputClassification.connectedPixelCount(100, true)
    .rename(bandNamesList.map(function(band) { return ee.String(band).cat('_conn'); }));

var inputWithConn = inputClassification.addBands(connectedPixelsImg);
var spatialFiltered = ee.Image();

YEARS.forEach(function(year, index) {
    var bandName = 'classification_' + year;
    var connBand = bandName + '_conn';
    
    var mode3x3 = inputWithConn.select(bandName).focal_mode(3, 'square', 'pixels');
    var maskSmallClusters = inputWithConn.select(connBand).lte(MIN_CONNECTED_PIXELS);
    
    // Replace small clusters with the focal mode
    var filteredBand = inputWithConn.select(bandName).blend(mode3x3.mask(maskSmallClusters));
    
    if (index === 0) spatialFiltered = filteredBand;
    else spatialFiltered = spatialFiltered.addBands(filteredBand);
});


// ------------------------------------------------------------------------------
// PHASE 2: NDDI FLOOD CALCULATION & FREQUENCY MASK
// ------------------------------------------------------------------------------
var nddiFloodMax = ee.Image();

YEARS.forEach(function(year, index) {
    var mosaic = colMosaics.filter(ee.Filter.eq('year', year)).mosaic();
    var mosaicIdx = addIndex.get(mosaic).clip(geometry);
    
    // Calculate NDDI Wet
    var nddiWet = mosaicIdx.normalizedDifference(['ndvi_median_wet','ndwi_median_wet']).add(1).multiply(1000);
    nddiWet = ee.Image(1).blend(nddiWet);
    
    var floodMax = nddiWet.lt(THRESHOLD_FLOOD).selfMask();
    var waterMax = nddiWet.lt(THRESHOLD_WATER).selfMask();
    
    // Create combined flood/water mask for the year
    var classWaterMax = ee.Image(21)
        .blend(floodMax.remap([1],[11]))
        .blend(waterMax.remap([1],[33]))
        .rename('classification_' + year);
        
    var maskMaxBand = ee.Image(21).blend(floodMax.remap([1],[11])).rename('classification_' + year);
    
    if (index === 0) nddiFloodMax = maskMaxBand;
    else nddiFloodMax = nddiFloodMax.addBands(maskMaxBand);
});

// Apply Spatial Filter to the NDDI Flood Mask
var nddiConn = nddiFloodMax.connectedPixelCount(100, true)
    .rename(bandNamesList.map(function(band) { return ee.String(band).cat('_conn'); }));
var nddiWithConn = nddiFloodMax.addBands(nddiConn);

var nddiFiltered = ee.ImageCollection(YEARS.map(function(year) {
    var bandName = 'classification_' + year;
    var mode3x3 = nddiWithConn.select(bandName).focal_mode(3, 'square', 'pixels');
    var maskSmall = nddiWithConn.select(bandName + '_conn').lte(MIN_CONNECTED_PIXELS);
    var filtered = nddiWithConn.select(bandName).blend(mode3x3.mask(maskSmall));
    
    // Return a mask where class is 11 (Flooded)
    return filtered.eq(11).rename('flood_mask');
})).sum();

// Accumulate flood rules
// Rule 1: Monthly flood frequency > 240
var freqMask = freqAlagado.select('class').gt(240).remap([1], [100], 0).toByte().selfMask();
// Rule 2: NDDI sum > 1
var nddiMask = nddiFiltered.gt(1).remap([1], [100], 0).toByte().selfMask();


// ------------------------------------------------------------------------------
// PHASE 3: APPLY MASKS AND REMAP FALSE POSITIVES
// ------------------------------------------------------------------------------
var finalClassification = ee.Image();

YEARS.forEach(function(year, index) {
    var bandName = 'classification_' + year;
    var currentBand = spatialFiltered.select(bandName);
    
    // Apply Mask 1 (Freq Alagado)
    var correctedFreq = currentBand.add(freqMask).remap(REMAP_FROM, REMAP_TO);
    var blended1 = currentBand.blend(correctedFreq.rename(bandName));
    
    // Apply Mask 2 (NDDI Sum)
    var correctedNddi = blended1.add(nddiMask).remap(REMAP_FROM, REMAP_TO);
    var blended2 = blended1.blend(correctedNddi.rename(bandName));
    
    if (index === 0) finalClassification = blended2;
    else finalClassification = finalClassification.addBands(blended2);
});

// ==============================================================================
// 4. VISUALIZATION (DEBUG)
// ==============================================================================
if (IS_DEBUG) {
    var debugYear = 2023;
    Map.addLayer(inputClassification.select('classification_' + debugYear), visPar, 'Input ' + debugYear, false);
    Map.addLayer(spatialFiltered.select('classification_' + debugYear), visPar, 'Spatial Filtered ' + debugYear, false);
    Map.addLayer(finalClassification.select('classification_' + debugYear), visPar, 'Final Masked ' + debugYear, true);
}

// ==============================================================================
// 5. METADATA AND EXPORT
// ==============================================================================
if (!IS_DEBUG) {
    finalClassification = finalClassification
        .set('territory', 'BRAZIL')
        .set('biome', 'PANTANAL')
        .set('source', 'arcplan')
        .set('version', VERSION_OUT)
        .set('collection_id', 3.0)
        .set('description', 'Spatial filter and Flooded masks (Freq + NDDI) applied');

    var outputName = PREFIX_OUT + VERSION_OUT;

    Export.image.toAsset({
        image: finalClassification,
        description: outputName,
        assetId: DIR_BASE + outputName,
        scale: 10,
        pyramidingPolicy: { '.default': 'mode' },
        maxPixels: 1e13,
        region: geometry
    });
}