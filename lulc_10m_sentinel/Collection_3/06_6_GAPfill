/**
 * @name 01_gap_fill.js
 * @description Applies temporal gap filling (forward and backward) to fix missing pixels in the annual classification.
 * @author @Mariana Dias / mariana@arcplan.com.br
 * @biome Pantanal
 */

// ==============================================================================
// 1. PARAMETERS AND CONSTANTS
// ==============================================================================
var IS_DEBUG = false; // Set to true to view on map, false to export

var VERSION_IN = '1';  // Matches the output of 02_merge_and_export.js
var VERSION_OUT = '1'; // Output version for Gap Fill

var DIR_BASE = 'projects/mapbiomas-workspace/AMOSTRAS/S2_EMBEDDING/PANTANAL/';
var ASSET_IN = DIR_BASE + 'PANT_col3_S2_annual_raw_v' + VERSION_IN;
var PREFIX_OUT = 'PANT_col3_S2_annual_gapfill_v';

var YEARS = [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025];
var METADATA_DESC = 'Temporal Gap Fill applied';

// ==============================================================================
// 2. IMPORTS AND GEOMETRIES
// ==============================================================================
var palettes = require('users/mapbiomas/modules:Palettes.js');
var visPar = { min: 0, max: 45, palette: palettes.get('classification5') };

// Load regions to define the bounding box for export
var regionsCollection = ee.FeatureCollection('projects/ee-arcplan-df/assets/regioes_pantanal');
var exportGeometry = regionsCollection.geometry().bounds();

// ==============================================================================
// 3. AUXILIARY FUNCTIONS (GAP FILL LOGIC)
// ==============================================================================
/**
 * Applies forward (t0 to tn) and backward (tn to t0) temporal gap filling.
 */
var applyGapFill = function (image, bandNamesList) {
    // 3.1. Forward Gap Fill (t0 to tn)
    var imageFilledForward = bandNamesList.slice(1).iterate(
        function (bandName, previousImage) {
            var currentImage = image.select(ee.String(bandName));
            previousImage = ee.Image(previousImage);
            
            // Unmask current image using the previous year's pixel
            currentImage = currentImage.unmask(previousImage.select([0]));
            return currentImage.addBands(previousImage);
        }, 
        ee.Image(image.select([bandNamesList.get(0)]))
    );
    imageFilledForward = ee.Image(imageFilledForward);

    // 3.2. Backward Gap Fill (tn to t0)
    var bandNamesReversed = bandNamesList.reverse();
    var imageFilledBackward = bandNamesReversed.slice(1).iterate(
        function (bandName, previousImage) {
            var currentImage = imageFilledForward.select(ee.String(bandName));
            previousImage = ee.Image(previousImage);
            
            // Unmask current image using the last band of the previous iteration
            currentImage = currentImage.unmask(previousImage.select(previousImage.bandNames().length().subtract(1)));
            return previousImage.addBands(currentImage);
        }, 
        ee.Image(imageFilledForward.select([bandNamesReversed.get(0)]))
    );

    // Reorder bands to match the original chronological order
    return ee.Image(imageFilledBackward).select(bandNamesList);
};

// ==============================================================================
// 4. MAIN PROCESSING
// ==============================================================================
// Load the raw merged classification image and mask out zeros
var rawImage = ee.Image(ASSET_IN);
rawImage = rawImage.mask(rawImage.neq(0));

// Build list of band names based on the defined years
var bandNamesList = ee.List(YEARS.map(function(year) {
    return 'classification_' + String(year);
}));

// Create a dictionary of band occurrences to ensure all requested bands exist
var bandsOccurrence = ee.Dictionary(
    bandNamesList.cat(rawImage.bandNames()).reduce(ee.Reducer.frequencyHistogram())
);

// Map through the expected bands. If it exists in rawImage (occurrence == 2), keep it. 
// If it's missing, create an empty masked band.
var bandsDictionary = bandsOccurrence.map(function (key, value) {
    return ee.Image(
        ee.Algorithms.If(
            ee.Number(value).eq(2),
            rawImage.select([key]).byte(),
            ee.Image().rename([key]).byte().updateMask(rawImage.select(0))
        )
    );
});

// Reconstruct the image with all expected bands
var imageAllBands = ee.Image(
    bandNamesList.iterate(function (band, img) {
        return ee.Image(img).addBands(bandsDictionary.get(ee.String(band)));
    }, ee.Image().select())
);

// Apply the Gap Fill function
var gapFilledImage = applyGapFill(imageAllBands, bandNamesList);

// ==============================================================================
// 5. VISUALIZATION (DEBUG)
// ==============================================================================
if (IS_DEBUG) {
    var debugYear = 2023; // Change this to check different years
    var bandName = 'classification_' + debugYear;
    
    Map.centerObject(exportGeometry, 6);
    Map.addLayer(rawImage.select(bandName), visPar, 'Raw Image ' + debugYear, false);
    Map.addLayer(gapFilledImage.select(bandName), visPar, 'Gap Filled ' + debugYear, true);
}

// ==============================================================================
// 6. METADATA AND EXPORT
// ==============================================================================
if (!IS_DEBUG) {
    gapFilledImage = gapFilledImage.toInt8()
        .set('territory', 'BRAZIL')
        .set('biome', 'PANTANAL')
        .set('source', 'arcplan')
        .set('version', VERSION_OUT)
        .set('collection_id', 3.0) // Adjust for Sentinel Col 3
        .set('description', METADATA_DESC);

    var outputName = PREFIX_OUT + VERSION_OUT;

    Export.image.toAsset({
        image: gapFilledImage,
        description: outputName,
        assetId: DIR_BASE + outputName,
        scale: 10,
        pyramidingPolicy: { '.default': 'mode' },
        maxPixels: 1e13,
        region: exportGeometry
    });
}