var versao_estavel = '3' // Defines the version of the stable reference map
var versao_out = '3' // Defines the version of the samples that will be generated

var direstavel = 'projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/SAMPLES/' // Defines the directory of the stable map
var dirout = 'projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/SAMPLES/'; // Defines the output directory for the samples

var biomes = ee.Image('projects/mapbiomas-workspace/AUXILIAR/biomas-raster-41') // Loads the MapBiomas biome map
var bioma250mil_MA = biomes.mask(biomes.eq(3)) // Masks the Pantanal biome
Map.addLayer(bioma250mil_MA, {}, 'bioma250mil_MA', false) // Adds the Pantanal biome map to the map, initially turned off

var palettes = require('users/mapbiomas/modules:Palettes.js'); // Loads the MapBiomas color palettes module
var vis = { // Defines the visualization parameters for the class map
    'min': 0,
    'max': 62,
    'palette': palettes.get('classification8')
};

var regioesCollection = ee.FeatureCollection('users/gee_arcplan/regs_mb_pantanal') // Loads the feature collection of the Pantanal regions
print(regioesCollection) // Prints the region collection to the console
Map.addLayer(regioesCollection) // Adds the region collection to the map

var colecao9 = ee.Image('projects/mapbiomas-public/assets/brazil/lulc/collection9/mapbiomas_collection90_integration_v1') // Loads the MapBiomas Collection 9
Map.addLayer(colecao9.select('classification_2023').eq(50).selfMask(), vis, 'Classes LANDSAT 23', false); // Adds class 50 (non-observed area) from 2023 as a layer on the map (turned off)

var mapa_estavel_S2 = ee.Image(direstavel+'PANT_amostras_estaveis16a23_v'+versao_estavel) // Loads the stable classification map
Map.addLayer(mapa_estavel_S2, vis, 'mapa_estavel_S2', false); // Adds the stable map to the map, initially turned off


var n_pr1 = 3000   // Number of points for the main class (scenario 1)
var n_se1 = 2000   // Number of points for the secondary class (scenario 1)
var n_ra1 = 1000    // Number of points for the rare class (scenario 1)
var zero1 = 0 // Zero number of points for scenario 1

var n_pr2 = 2500   // Number of points for the main class (scenario 2)
var n_se2 = 1500   // Number of points for the secondary class (scenario 2)
var n_ra2 = 500    // Number of points for the rare class (scenario 2)
var zero2 = 0 // Zero number of points for scenario 2

var regioes_lista = [//regiao,   3,    4,     12,    19,    21,     25,    33, ], // List of regions and number of points per class
                    ['reg0', n_se1, n_se1, n_pr1,  zero1, n_se1,  n_ra1, n_pr2,],//ok
                    ['reg1', n_pr2, n_pr1, n_pr1,  zero1, n_se2,  n_ra1, n_se2,],//ok
                    ['reg2', n_pr2, n_pr2, n_pr1,  zero1, n_pr2,  zero1, n_pr2,],//ok
                    ['reg3', n_pr2, n_pr2, n_pr2,  zero1, n_pr2,  zero1, n_se2,],//ok
                    ['reg4', n_pr1, n_pr1, n_se1,  zero1, n_pr2,  n_ra2, n_se2,],//ok
                    ['reg5', n_se2, n_pr2, n_pr2,  zero1, n_pr2,  zero1, n_se2,],//ok
                    ['reg6', n_se2, n_pr2, n_pr1,  n_ra1, n_pr2,  zero1, n_se2,],//ok
              ]

for (var i_regiao=0;i_regiao<regioes_lista.length; i_regiao++){ // Loop for each region in the list
  var lista = regioes_lista[i_regiao]; // Gets the list of values for the current region
  var regiao = lista[0]; // Gets the region ID

  var limite = regioesCollection.filterMetadata('id_reg', "equals", regiao); // Filters the region collection to get the boundary of the current region
  
  // Generates stratified samples from the stable map
  var reg_training_estavel = mapa_estavel_S2.stratifiedSample({
    'numPoints': 0, // Defines that the number of points to be generated will be defined by class
    'classBand': 'reference', // Defines the band to be used for stratification
    'region': limite, // Defines the region for sampling
    'classValues': [       3,       4,         12,       19,      21,       25,       33,  ], // Class values
    'classPoints': [lista[1], lista[2],  lista[3], lista[4], lista[5], lista[6], lista[7],], // Number of points per class
    'scale': 10, // Defines the sampling scale (10 meters)
    'seed': 1, // Defines the seed for reproducibility
    'geometries': true // Returns the geometries of the samples
  })
  
  
   reg_training_estavel = reg_training_estavel.map( // Adds an attribute with the name of the region for each sample
            function (feature) {
                return feature.set('id_reg', regiao);
            });
  // Exports the sample table for the region to Google Earth Engine Assets
  Export.table.toAsset(reg_training_estavel, 'samples_S2_stable_v'+versao_out+'_'+regiao, dirout+ 'samples_S2_stable_v'+versao_out+'_'+regiao)
  print(regiao,reg_training_estavel.size()) // Prints the region ID and the number of samples generated for this region
  
  if (i_regiao == 0){ var training_estavel = reg_training_estavel }  // If it is the first region, initializes the sample union variable
  else {training_estavel = training_estavel.merge(reg_training_estavel); } // Otherwise, joins the samples from the current region with those from previous regions
  
}
Map.addLayer(training_estavel) // Adds the samples to the map
print(training_estavel.size()) // Prints the total number of samples generated

// Exports the unified sample table to Google Earth Engine Assets
Export.table.toAsset(training_estavel, 'samples_S2_stable_v'+versao_out+'_reg', dirout+ 'samples_S2_stable_v'+versao_out+'_reg');



