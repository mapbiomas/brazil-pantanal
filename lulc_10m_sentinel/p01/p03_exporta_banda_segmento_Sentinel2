var asset = 'projects/mapbiomas-mosaics/assets/SENTINEL/BRAZIL/mosaics-3'; // Defines the asset path for Sentinel-2 mosaics
var addIndexCaatinga = require('users/gee_arcplan/MapBiomas_Col9_Pantanal:processa_Bandas_Sentinel2_CAATINGA'); // Loads a script for processing Sentinel-2 bands
var dirout = 'projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/'; // Defines the output directory for assets

for (var i_ano=0;i_ano<anos.length; i_ano++){ // Loops through each year
  var ano = anos[i_ano]; // Gets the current year

  // Loads the Sentinel-2 mosaic for the current year and biome
  var collection = ee.ImageCollection(asset)
        .filter(ee.Filter.eq('version', '3'))
        .filter(ee.Filter.eq('year', ano))
        .filter(ee.Filter.inList('biome', [
            'PANTANAL',
        ])); 
  var mosaicoTotal = collection.mosaic() // Creates a mosaic from the collection
  mosaicoTotal = addIndexCaatinga.get(mosaicoTotal); // Adds additional indices using the imported script

//  print(mosaicoTotal)
  // Applies the SNIC algorithm to the image.
  var snic = ee.Algorithms.Image.Segmentation.SNIC({
    image: mosaicoTotal.select(['ndvi_median_dry','ndvi_median_wet',
    'ndwi_median','green_median_texture']), // Selects the bands to be used in the SNIC algorithm
    size: 20, // Defines the size of the segments
    compactness: 0.4, // Defines the compactness of the segments
    connectivity: 8, // Defines the connectivity of the segments
  });
  
  // Displays the clusters.
  Map.addLayer(snic.randomVisualizer(), null, 'Clusters'); // Adds the clusters as a layer to the map

  if (i_ano == 0){ var mosaicoPANT = snic.select(
    ["clusters",
  'ndvi_median_dry_mean','ndvi_median_wet_mean',
    'ndwi_median_mean','green_median_texture_mean'], // Selects the bands to keep after SNIC
    ["clusters_"+ano,
    'ndvi_median_dry_'+ano,'ndvi_median_wet_'+ano,
    'ndwi_median_'+ano,'green_median_texture_'+ano]) // Renames the bands with the year
                  }
  else {mosaicoPANT = mosaicoPANT.addBands(snic.select(
    ["clusters",
  'ndvi_median_dry_mean','ndvi_median_wet_mean',
    'ndwi_median_mean','green_median_texture_mean'],
    ["clusters_"+ano,
    'ndvi_median_dry_'+ano,'ndvi_median_wet_'+ano,
    'ndwi_median_'+ano,'green_median_texture_'+ano]))
       } // If it is not the first year, adds the bands with the SNIC results for the current year to the previous mosaics


}

print(mosaicoPANT) // Prints the final processed mosaic to the console


// Exports the processed mosaic to Google Earth Engine Assets
