var versao_out = '1'; // Defines the output version
var versao_pt = '3'; // Defines the version of the training samples
var ano = 2016; // Defines the year for which to extract the data
var dirout = 'projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/SAMPLES/'; // Defines the output directory

var palettes = require('users/mapbiomas/modules:Palettes.js'); // Loads the MapBiomas palettes module
var vis = { // Defines visualization parameters for a classification map
    'min': 0,
    'max': 45,
    'palette': palettes.get('classification5')
};
var regioesCollection = ee.FeatureCollection('users/gee_arcplan/regs_mb_pantanal');//.filterBounds(geometry); // Loads the feature collection of regions
Map.addLayer(regioesCollection); // Adds the regions to the map

var palettes = require('users/mapbiomas/modules:Palettes.js'); // Loads the MapBiomas palettes module again (redundant, but kept for consistency with original code)

var vis = { // Defines visualization parameters for a classification map
    'min': 0,
    'max': 69,
    'palette': palettes.get('classification9')
};

//Map.addLayer(bioma250mil_MA,{},"biome MA",false)

var asset_mosaicosS2 = 'projects/mapbiomas-mosaics/assets/SENTINEL/BRAZIL/mosaics-3'; // Defines the asset path for Sentinel-2 mosaics
var bioma = "PANTANAL"; // Defines the biome
var pts = ee.FeatureCollection('projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/SAMPLES/samples_S2_stable_v'+versao_pt+'_reg'); // Loads the feature collection of training samples
var S2_cluster = ee.Image('projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/mosaicos_PANT_S2_clusters_2016_2023') // Loads the cluster image generated in a previous step

//var anos = [
//            2016,2017,2018,2019,
//            2020,2021,
//            2022,2023
//            ];

var addIndexCaatinga = require('users/gee_arcplan/MapBiomas_Col9_Pantanal:processa_Bandas_Sentinel2_CAATINGA'); // Loads a script for processing Sentinel-2 bands

var ndvi_color = '0f330f, 005000, 4B9300, 92df42, bff0bf, FFFFFF, eee4c7, ecb168, f90000'; // Defines colors for NDVI visualization
var visParNDFI_amp = {'min':0, 'max':300, 'palette':ndvi_color}; // Defines visualization parameters for a NDFI image

var regioes_lista = [ // Defines a list of regions to process
      ['reg0'],['reg1'],['reg2'],['reg3'],['reg4'],['reg5'],['reg6'],
      ];
 
for (var i_regiao=0;i_regiao<regioes_lista.length; i_regiao++){ // Loops through each region
  var lista = regioes_lista[i_regiao];
  var regiao = lista[0]; // Gets the ID of the current region
  var limite = regioesCollection.filterMetadata('id_reg', "equals", regiao); // Filters the region collection to get the boundary for the current region
  
  var asset = 'projects/mapbiomas-mosaics/assets/SENTINEL/BRAZIL/mosaics-3'; // Redefines the asset path for Sentinel-2 mosaics

  // Loads the Sentinel-2 mosaic for the defined year and biome
  var collection = ee.ImageCollection(asset)
        .filter(ee.Filter.eq('version', '3'))
        .filter(ee.Filter.eq('year', ano))
        .filter(ee.Filter.inList('biome', [
            'PANTANAL',
        ])); 

  var mosaicoTotal = collection.mosaic() // Creates a mosaic from the collection
  mosaicoTotal = addIndexCaatinga.get(mosaicoTotal); // Adds indices to the mosaic

  // Adds the cluster bands from the pre-computed cluster image
  mosaicoTotal = mosaicoTotal.addBands(S2_cluster.select([
    'clusters_'+ano, 'ndvi_median_dry_'+ano,'ndvi_median_wet_'+ano,'ndwi_median_'+ano, 'green_median_texture_'+ano
    ]))
  
  Map.addLayer(mosaicoTotal, {'bands': ['swir1_median', 'nir_median', 'red_median'],
    'gain': [0.08, 0.07, 0.2],'gamma': 0.85}, 'Sentinel 2 '+ano, false); // Adds the Sentinel-2 mosaic to the map

  var pts_reg = pts.filterMetadata('id_reg', 'equals', regiao) // Filters training samples to keep the ones in the current region
  
  // Extracts data from the mosaic for the training samples
  var training = mosaicoTotal.sampleRegions({
      'collection': pts_reg,
      'scale': 10,
      'tileScale': 4,
      'geometries': true
  });

  //print('amostras treinadas',training.limit(1))
  if (i_regiao == 0){ var training_reg = training }  // If this is the first region, initializes the training variable
  else {training_reg = training_reg.merge(training); } // If it is not the first region, merges the training data with the previous one
}    

print(training_reg.limit(10)) // Prints the first 10 results to the console

// Exports the extracted data to Google Earth Engine Assets
Export.table.toAsset(training_reg, 'pontos_train_v'+versao_out+'_'+ano, dirout + 'pontos_train_v'+versao_out+'_'+ano);


