// This script applies a spatial filter to a classification image for multiple years, blending the original classification with a mode-filtered version where connected pixel groups are below a threshold.

var bioma = "PANTANAL"

var vesion_in = '3'
var versao_out = '1'
var min_connect_pixel = 25

var prefixo_in = 'PANT_s2_Anual_'
var prefixo_out = 'PANT_s2_Anual_p05_v'
var dirin = 'projects/mapbiomas-workspace/AMOSTRAS/S2_2024/PANTANAL/classifica_bruto/'
var dirout = 'projects/mapbiomas-workspace/AMOSTRAS/col9/PANTANAL/S2/pos-classificacao/'


var class4GAP = ee.Image(dirin+prefixo_in+vesion_in)//.mask(bioma250mil_MA)
print(class4GAP)

