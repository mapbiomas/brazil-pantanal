var palettes = require('users/mapbiomas/modules:Palettes.js'); // Import the palettes module
var pal = palettes.get('classification2'); // Get a color palette
var vis = { // Visualization parameters
      bands: 'classification_2021',
    'min': 0,
    'max': 68,
    'palette': palettes.get('classification9')
    };
var vis2 = { // Another visualization parameter set
    'min': 0,
    'max': 68,
    'palette': palettes.get('classification9')
};

var palettes = require('users/mapbiomas/modules:Palettes.js'); // Import the palettes module again (unnecessary, already done above)


Map.addLayer(class4GAP, vis, 'class4GAP'); // Add the original classification image to the map

// Define an array of years to process
var anos = ['2016','2017','2018','2019','2020','2021', '2022','2023'];
//var anos = ['1985']
// Loop through each year
for (var i_ano=0;i_ano<anos.length; i_ano++){  
  var ano = anos[i_ano]; 
  
  // Apply a focal mode filter to the classification for the current year
  var moda = class4GAP.select('classification_'+ano).focal_mode(3, 'square', 'pixels')
  // Mask the mode-filtered image where connected pixel groups are below a threshold
  moda = moda.mask(class4GAP.select('classification_'+ano+'_conn').lte(min_connect_pixel))
  // Blend the original classification with the masked mode-filtered result
  var class_out = class4GAP.select('classification_'+ano).blend(moda)
  
  // Store the processed image for the first year, or add to a multiband image for subsequent years
  if (i_ano == 0){ var class_outTotal = class_out }  
  else {class_outTotal = class_outTotal.addBands(class_out); }
}

print(class_outTotal) // Print the multiband processed image
Map.addLayer(class_outTotal, vis, 'class_outTotal'); // Add the processed image to the map
// Map.addLayer(class_out2, vis, 'class_out2');
var descricao = 'filtro espacial p05a' // Set a description for the output

// Set metadata properties for the processed image
class_outTotal = class_outTotal
.set('territory', 'BRAZIL')
.set('biome', 'PANTANAL')
.set('source', 'arcplan')
.set('version', versao_out)
//.set('year', versao_out)
.set('collection_id', 9)
.set('description', descricao)


// Export the processed image to Google Earth Engine Assets
Export.image.toAsset({
    'image': class_outTotal,
    'description': prefixo_out+versao_out,
    'assetId': dirout+prefixo_out+versao_out,
    'pyramidingPolicy': {
        '.default': 'mode'
    },
