// This script refines a classification image by correcting flooded areas misclassified as pasture areas using monthly flood frequency data.

var bioma = "PANTANAL";

var vesion_in = '1';
var versao_out = '2';

var prefixo_in = 'PANT_s2_Anual_p05_v';
var prefixo_out = 'PANT_s2_Anual_p05_v';
var dirin = 'projects/mapbiomas-workspace/AMOSTRAS/col9/PANTANAL/S2/pos-classificacao/';
var dirout = 'projects/mapbiomas-workspace/AMOSTRAS/col9/PANTANAL/S2/pos-classificacao/';

// Load the input classification image
var class4GAP = ee.Image(dirin+prefixo_in+vesion_in);//.mask(bioma250mil_MA)
print(class4GAP);

// Import the palettes module
var palettes = require('users/mapbiomas/modules:Palettes.js');
// Define visualization parameters
var vis = {
    'min': 0,
    'max': 62,
    'palette': palettes.get('classification8')
};

////corrigir FP de pastagem com frequencia de inundação mensal
// Set the final image to the vfinal image
var col8 = class4GAP;

// Load the monthly flood frequency image
var freqAlagado = ee.Image('projects/mapbiomas-workspace/AMOSTRAS/col8/PANTANAL/SAMPLES/mensal/frequenciaAcumulada_33_11_v2');
 
 

  var asset = 'projects/mapbiomas-mosaics/assets/SENTINEL/BRAZIL/mosaics-3';

// Define the years to process
var anos = [
            2016,2017,2018,2019,2020,2021,2022,2023
            ];


 // Create a mask for areas with a flood frequency greater than 115. Areas with high flood frequency are considered as misclassified pasture and remapped to a different code.
 var to_mask_campo = freqAlagado.select('class').gt(115).remap([1],[100],0).toByte().selfMask();

// Loop through each year
for (var i_ano=0;i_ano<anos.length; i_ano++){
  // Get the current year
  var ano = anos[i_ano];

// Add the mask to the classification band and remap the values. The remapping changes pasture (3, 4, etc) to different codes depending on the flood mask
var class_corr_agr_ano = col8.select('classification_'+ano).add(to_mask_campo)
                         .remap([3,4,12,19,21,22,25,33,103,104,112,119,121,122,125,133],
                                [3,4,12,19,21,22,25,33, 12, 12, 12, 12, 12, 22, 12, 33]);


// Blend the original classification band with the corrected band
var saida_ano = col8.select('classification_'+ano).blend(class_corr_agr_ano.rename('classification_'+ano));

 // Create an image collection from the mosaics asset
 var mosaicoTotal = ee.ImageCollection(asset)
                        .filterMetadata('biome', 'equals', 'PANTANAL')
                        .filterMetadata('year', 'equals', ano)
 //                       .filter(ee.Filter.eq('satellite', asset1))
                        //.filterBounds(geometry)
                        .mosaic();
// Add the mosaics to the map
Map.addLayer(mosaicoTotal, {bands: ['swir1_median', 'nir_median', 'red_median'],gain: [0.08, 0.06, 0.2],gamma: 0.85}, 'mosaico '+ano,false);
// Add the original and corrected images to the map
Map.addLayer(col8.select(['classification_'+ano]),vis,'Original '+ano,false);
Map.addLayer(saida_ano,vis,'corrigido mask '+ano,false);

   // If it's the first iteration, initialize the output image
   if (i_ano == 0){ var class_outTotal_mask = saida_ano;}
  // Otherwise, add the current year's image to the output image
  else {class_outTotal_mask = class_outTotal_mask.addBands(saida_ano);}
}

 
// Print the output image
print('final class_outTotal_mask', class_outTotal_mask);


